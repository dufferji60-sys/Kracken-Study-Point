DATABASE_URL=postgresql://user:password@host:5432/kraken_study
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_USERNAME=Kracken
ADMIN_PASSWORD=Kracken@123
# Starter login above is for private testing only; replace the password before a public launch.

# S3-compatible persistent object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.)
STORAGE_BUCKET=replace-with-bucket-name
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://your-s3-compatible-endpoint.example.com
STORAGE_ACCESS_KEY_ID=replace-with-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-secret-key
PRIVATE_OBJECT_DIR=kraken-study/private
PUBLIC_OBJECT_SEARCH_PATHS=kraken-study/public

# Frontend/runtime
PORT=5000
BASE_PATH=/
