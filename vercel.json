{
  "buildCommand": "pnpm --filter @workspace/kraken-study run build",
  "outputDirectory": "artifacts/kraken-study/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}